{
  "name": "deception-scenario-08",
  "description": "IAM Role Chain Loop — AssumeRole on 3 circular roles + GetParameter on SSM params",
  "scenario_number": 8,
  "scenario_name": "IAM Role Chain Loop",
  "event_pattern": {
    "source": ["aws.sts", "aws.ssm"],
    "detail-type": ["AWS API Call via CloudTrail"],
    "detail": {
      "eventName": ["AssumeRole", "GetParameter"],
      "$or": [
        {
          "requestParameters": {
            "roleName": ["prod-microservice-auth-role", "prod-microservice-data-role", "prod-microservice-admin-role"]
          }
        },
        {
          "requestParameters": {
            "name": [
              {"prefix": "/prod/auth/"},
              {"prefix": "/prod/data/"},
              {"prefix": "/prod/admin/"}
            ]
          }
        }
      ]
    }
  }
}
