{
  "name": "deception-scenario-02",
  "description": "Secrets Manager Payment Credentials Lure — AssumeRole + GetSecretValue on decoy secrets",
  "scenario_number": 2,
  "scenario_name": "Secrets Manager Payment Credentials Lure",
  "event_pattern": {
    "source": ["aws.sts", "aws.secretsmanager"],
    "detail-type": ["AWS API Call via CloudTrail"],
    "detail": {
      "eventName": ["AssumeRole", "GetSecretValue"],
      "$or": [
        {
          "requestParameters": {
            "roleName": ["payment-secrets-readonly-role"]
          }
        },
        {
          "requestParameters": {
            "secretId": [
              {"prefix": "prod/payment-gateway/"},
              {"prefix": "prod/internal-api/service-accounts"}
            ]
          }
        }
      ]
    }
  }
}
