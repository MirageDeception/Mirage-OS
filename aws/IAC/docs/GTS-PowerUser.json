{
    "Statement": [
        {
            "Effect": "Allow",
            "NotAction": [
                "sts:AssumeRole",
                "organizations:*",
                "iam:*"
            ],
            "Resource": "*"
        },
        {
            "Action": [
                "organizations:DescribeOrganization",
                "iam:PassRole",
                "iam:List*",
                "iam:Get*"
            ],
            "Effect": "Allow",
            "Resource": "*"
        },
        {
            "Action": [
                "organizations:List*",
                "organizations:Get*",
                "organizations:Describe*"
            ],
            "Effect": "Allow",
            "Resource": "*"
        },
        {
            "Action": [
                "savingsplans:UntagResource",
                "savingsplans:TagResource",
                "savingsplans:CreateSavingsPlan",
                "redshift:PurchaseReservedNodeOffering",
                "redshift:GetReservedNodeExchangeOfferings",
                "redshift:AcceptReservedNodeExchange",
                "rds:PurchaseReservedDBInstancesOffering",
                "es:PurchaseReservedElasticsearchInstanceOffering",
                "elasticache:PurchaseReservedCacheNodesOffering",
                "ec2:PurchaseReservedInstancesOffering",
                "ec2:ModifyReservedInstances",
                "ec2:CreateReservedInstancesListing",
                "ec2:CancelReservedInstancesListing",
                "ec2:AcceptReservedInstancesExchangeQuote",
                "dynamodb:PurchaseReservedCapacityOfferings"
            ],
            "Effect": "Deny",
            "Resource": "*",
            "Sid": "DenyRIs"
        },
        {
            "Action": [
                "iam:UploadSSHPublicKey",
                "iam:UpdateUser",
                "iam:UpdateServiceSpecificCredential",
                "iam:UpdateSSHPublicKey",
                "iam:UpdateRoleDescription",
                "iam:UpdateRole",
                "iam:UpdateAssumeRolePolicy",
                "iam:UpdateAccessKey",
                "iam:UntagUser",
                "iam:UntagRole",
                "iam:TagUser",
                "iam:TagRole",
                "iam:SetDefaultPolicyVersion",
                "iam:ResetServiceSpecificCredential",
                "iam:ReSyncMFADevice",
                "iam:PutUserPolicy",
                "iam:PutUserPermissionsBoundary",
                "iam:PutRolePolicy",
                "iam:PutRolePermissionsBoundary",
                "iam:EnableMFADevice",
                "iam:DetachUserPolicy",
                "iam:DetachRolePolicy",
                "iam:DeleteUserPolicy",
                "iam:DeleteUserPermissionsBoundary",
                "iam:DeleteUser",
                "iam:DeleteSigningCertificate",
                "iam:DeleteServiceSpecificCredential",
                "iam:DeleteServiceLinkedRole",
                "iam:DeleteSSHPublicKey",
                "iam:DeleteRolePolicy",
                "iam:DeleteRolePermissionsBoundary",
                "iam:DeleteRole",
                "iam:DeletePolicyVersion",
                "iam:DeletePolicy",
                "iam:DeactivateMFADevice",
                "iam:CreateUser",
                "iam:CreateServiceSpecificCredential",
                "iam:CreateServiceLinkedRole",
                "iam:CreateRole",
                "iam:CreatePolicyVersion",
                "iam:CreatePolicy",
                "iam:CreateAccessKey",
                "iam:AttachUserPolicy",
                "iam:AttachRolePolicy"
            ],
            "Effect": "Deny",
            "Resource": [
                "arn:aws:iam::913511275171:user/GTS-*",
                "arn:aws:iam::913511275171:role/GTS-*",
                "arn:aws:iam::913511275171:policy/GTS-*"
            ]
        },
        {
            "Action": [
                "cloudtrail:UpdateTrail",
                "cloudtrail:StopLogging",
                "cloudtrail:StartLogging",
                "cloudtrail:RemoveTags",
                "cloudtrail:PutEventSelectors",
                "cloudtrail:DeleteTrail",
                "cloudtrail:CreateTrail",
                "cloudtrail:AddTags"
            ],
            "Effect": "Deny",
            "Resource": [
                "arn:aws:cloudtrail:us-west-2:913511275171:trail/gts-*",
                "arn:aws:cloudtrail:us-west-2:913511275171:trail/GTS-*"
            ]
        },
        {
            "Action": [
                "logs:UntagLogGroup",
                "logs:TagLogGroup",
                "logs:PutSubscriptionFilter",
                "logs:PutRetentionPolicy",
                "logs:PutMetricFilter",
                "logs:DisassociateKmsKey",
                "logs:DeleteSubscriptionFilter",
                "logs:DeleteRetentionPolicy",
                "logs:DeleteMetricFilter",
                "logs:DeleteLogStream",
                "logs:DeleteLogGroup",
                "logs:CreateLogStream",
                "logs:CreateExportTask",
                "logs:AssociateKmsKey"
            ],
            "Effect": "Deny",
            "Resource": [
                "arn:aws:logs:*:913511275171:log-group:gts-*:log-stream:*",
                "arn:aws:logs:*:913511275171:log-group:gts-*",
                "arn:aws:logs:*:913511275171:log-group:GTS-*:log-stream:*",
                "arn:aws:logs:*:913511275171:log-group:GTS-*"
            ]
        },
        {
            "Action": [
                "s3:PutReplicationConfiguration",
                "s3:PutMetricsConfiguration",
                "s3:PutLifecycleConfiguration",
                "s3:PutInventoryConfiguration",
                "s3:PutEncryptionConfiguration",
                "s3:PutBucketWebsite",
                "s3:PutBucketVersioning",
                "s3:PutBucketTagging",
                "s3:PutBucketRequestPayment",
                "s3:PutBucketPublicAccessBlock",
                "s3:PutBucketPolicy",
                "s3:PutBucketNotification",
                "s3:PutBucketLogging",
                "s3:PutBucketCORS",
                "s3:PutBucketAcl",
                "s3:PutAnalyticsConfiguration",
                "s3:PutAccelerateConfiguration",
                "s3:DeleteBucketWebsite",
                "s3:DeleteBucketPolicy",
                "s3:DeleteBucket",
                "s3:CreateBucket"
            ],
            "Effect": "Deny",
            "Resource": [
                "arn:aws:s3:::gts-*",
                "arn:aws:s3:::GTS-*"
            ]
        },
        {
            "Action": [
                "s3:RestoreObject",
                "s3:ReplicateTags",
                "s3:ReplicateObject",
                "s3:ReplicateDelete",
                "s3:PutObjectVersionTagging",
                "s3:PutObjectVersionAcl",
                "s3:PutObjectTagging",
                "s3:PutObjectAcl",
                "s3:PutObject",
                "s3:DeleteObjectVersionTagging",
                "s3:DeleteObjectVersion",
                "s3:DeleteObjectTagging",
                "s3:DeleteObject",
                "s3:AbortMultipartUpload"
            ],
            "Effect": "Deny",
            "Resource": [
                "arn:aws:s3:::gts-*/*",
                "arn:aws:s3:::GTS-*/*"
            ]
        },
        {
            "Action": [
                "sns:Subscribe",
                "sns:SetTopicAttributes",
                "sns:RemovePermission",
                "sns:Publish",
                "sns:DeleteTopic",
                "sns:CreateTopic",
                "sns:ConfirmSubscription",
                "sns:AddPermission"
            ],
            "Effect": "Deny",
            "Resource": [
                "arn:aws:sns:*:913511275171:gts-*",
                "arn:aws:sns:*:913511275171:GTS-*"
            ]
        },
        {
            "Action": [
                "ec2:UpdateSecurityGroupRuleDescriptionsIngress",
                "ec2:UpdateSecurityGroupRuleDescriptionsEgress",
                "ec2:RevokeSecurityGroupIngress",
                "ec2:RevokeSecurityGroupEgress",
                "ec2:DeleteTags",
                "ec2:DeleteSecurityGroup",
                "ec2:CreateTags",
                "ec2:AuthorizeSecurityGroupIngress",
                "ec2:AuthorizeSecurityGroupEgress"
            ],
            "Condition": {
                "StringLike": {
                    "ec2:ResourceTag/fico:common:owner": "AWS Cloud Engineering"
                }
            },
            "Effect": "Deny",
            "Resource": "arn:aws:ec2:*:913511275171:security-group/*"
        },
        {
            "Action": [
                "ec2:RejectVpcPeeringConnection",
                "ec2:DeleteVPCPeeringConnection",
                "ec2:DeleteTags",
                "ec2:CreateTags",
                "ec2:AcceptVpcPeeringConnection"
            ],
            "Condition": {
                "StringLike": {
                    "ec2:ResourceTag/fico:common:owner": "AWS Cloud Engineering"
                }
            },
            "Effect": "Deny",
            "Resource": "arn:aws:ec2:*:913511275171:vpc-peering-connection/*"
        },
        {
            "Action": [
                "ec2:DeleteTags",
                "ec2:CreateTags"
            ],
            "Condition": {
                "StringLike": {
                    "ec2:ResourceTag/fico:common:owner": "AWS Cloud Engineering"
                }
            },
            "Effect": "Deny",
            "Resource": "arn:aws:ec2:*:913511275171:vpn-gateway/*"
        },
        {
            "Action": [
                "config:StopConfigurationRecorder",
                "config:StartConfigurationRecorder",
                "config:PutDeliveryChannel",
                "config:PutConfigurationRecorder",
                "config:DeleteDeliveryChannel",
                "config:DeleteConfigurationRecorder"
            ],
            "Effect": "Deny",
            "Resource": "*"
        },
        {
            "Action": "iam:CreateUser",
            "Effect": "Deny",
            "Resource": "*"
        }
    ],
    "Version": "2012-10-17"
}