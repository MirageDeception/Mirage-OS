{
  "name": "deception-scenario-19",
  "description": "CloudFormation Stack Outputs — AssumeRole + DescribeStacks on decoy stack",
  "scenario_number": 19,
  "scenario_name": "CloudFormation Stack Outputs Exposed Secrets Lure",
