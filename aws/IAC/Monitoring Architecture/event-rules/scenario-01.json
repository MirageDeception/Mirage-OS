{
  "name": "deception-scenario-01",
  "description": "S3 Terraform State Lure — AssumeRole on lure role + S3 GetObject on decoy bucket",
  "scenario_number": 1,
  "scenario_name": "S3 Terraform State Lure",
  "event_pattern": {
    "source": ["aws.sts", "aws.s3"],
    "detail-type": ["AWS API Call via CloudTrail"],
    "detail": {
      "eventName": ["AssumeRole", "GetObject"],
      "$or": [
        {
          "requestParameters": {
            "roleName": ["infra-s3-data-readonly-role"]
          }
        },
        {
          "requestParameters": {
            "bucketName": [{"prefix": "infra-terraform-state-"}]
          }
        }
      ]
    }
  }
}
