    "source": ["aws.sts", "aws.cloudformation"],
    "detail-type": ["AWS API Call via CloudTrail"],
    "detail": {
      "eventName": ["AssumeRole", "DescribeStacks"],
      "$or": [
        {
          "requestParameters": {
            "roleName": ["cfn-audit-readonly-role"]
          }
        },
        {
          "requestParameters": {
            "stackName": [{"prefix": "prod-core-infrastructure"}]
          }
        }
      ]
    }
  }
}
